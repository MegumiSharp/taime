<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/taime_widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/t_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="Oggi"
            android:textColor="@color/taime_widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/t_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/taime_widget_button_soft"
            android:contentDescription="Nuovo to-do"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/taime_widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/t_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:text="Niente per oggi"
        android:textColor="@color/taime_widget_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/t_row0"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check0"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Segna come fatto"
            android:padding="8dp"
            android:src="@drawable/ic_taime_check_ring" />

        <TextView
            android:id="@+id/t_title0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/taime_widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_meta0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="@color/taime_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/t_row1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Segna come fatto"
            android:padding="8dp"
            android:src="@drawable/ic_taime_check_ring" />

        <TextView
            android:id="@+id/t_title1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/taime_widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_meta1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="@color/taime_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/t_row2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Segna come fatto"
            android:padding="8dp"
            android:src="@drawable/ic_taime_check_ring" />

        <TextView
            android:id="@+id/t_title2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/taime_widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_meta2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="@color/taime_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/t_row3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Segna come fatto"
            android:padding="8dp"
            android:src="@drawable/ic_taime_check_ring" />

        <TextView
            android:id="@+id/t_title3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/taime_widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_meta3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="@color/taime_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/t_row4"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Segna come fatto"
            android:padding="8dp"
            android:src="@drawable/ic_taime_check_ring" />

        <TextView
            android:id="@+id/t_title4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/taime_widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_meta4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="@color/taime_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/t_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/taime_widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
